<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".chat">

    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:background="@android:color/white"
        android:padding="8dp">

        <ImageView
            android:id="@+id/back_arrow"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_arrow_back"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/chat_profile"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/profile"
            android:layout_toEndOf="@id/back_arrow"
            android:layout_marginStart="8dp"
            android:layout_centerVertical="true"
            app:civ_border_width="1dp"
            app:civ_border_color="#9B5A5A"/>

        <LinearLayout
            android:id="@+id/name_status_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/chat_profile"
            android:layout_marginStart="8dp"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/chat_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat User"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <View
                    android:id="@+id/online_indicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/online_indicator_gray"/>

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="12sp"/>
            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/info"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_info"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"/>

        <ImageView
            android:id="@+id/video_call_btn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_video_call"
            android:layout_toStartOf="@id/info"
            android:layout_marginEnd="16dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <FrameLayout
            android:id="@+id/screenshot_alerts_container"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_toStartOf="@id/video_call_btn"
            android:layout_marginEnd="16dp"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/screenshot_alerts_btn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_screenshot_alert"/>

            <TextView
                android:id="@+id/screenshot_alerts_badge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/notification_badge"
                android:gravity="center"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"/>

        </FrameLayout>

        <ImageView
            android:id="@+id/video_call"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_video"
            android:layout_toStartOf="@id/screenshot_alerts_btn"
            android:layout_marginEnd="16dp"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar"
        android:layout_above="@id/message_bar"
        android:padding="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <RelativeLayout
        android:id="@+id/message_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"
        android:padding="8dp">

        <RelativeLayout
            android:id="@+id/input_container"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/edittext_background"
            android:padding="5dp">

            <ImageView
                android:id="@+id/imageButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_gallery"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <EditText
                android:id="@+id/messageEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Message..."
                android:background="@android:color/transparent"
                android:layout_toEndOf="@id/imageButton"
                android:layout_toStartOf="@id/sendButton"
                android:layout_marginStart="8dp"
                android:padding="5dp"
                android:inputType="text"/>

            <ImageView
                android:id="@+id/sendButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_send"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>
